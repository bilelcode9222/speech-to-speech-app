{
  "expo": {
    "name": "Traduction vocale — Nevi AI",
    "slug": "voix-traduction",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bilelzouaoui.neviai",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.bilelzouaoui.neviai",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      "expo-asset",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr", "es", "de", "it", "pt", "nl", "ru", "ar", "zh", "ja"],
            "android": ["en", "fr", "es", "de", "it", "pt", "nl", "ru", "ar", "zh", "ja"]
          }
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json",
      "nl": "./locales/nl.json",
      "ru": "./locales/ru.json",
      "ar": "./locales/ar.json",
      "zh": "./locales/zh.json",
      "ja": "./locales/ja.json"
    },
    "extra": {
      "eas": {
        "projectId": "82f90eae-81dc-4094-b442-9917a991bd34"
      }
    },
    "owner": "bibi9213"
  }
}
