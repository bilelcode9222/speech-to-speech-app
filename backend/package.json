{
  "name": "speech-to-speech-backend",
  "version": "1.0.0",
  "description": "Backend d'orchestration STT -> Traduction -> TTS",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "postbuild": "npm prune --omit=dev",
    "start": "node dist/server.js",
    "check": "tsc --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "form-data": "^4.0.6",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
