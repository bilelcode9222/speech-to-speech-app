# Sécurité backend — obligatoire en local et sur Render.
# Génère une longue valeur aléatoire, par exemple avec : openssl rand -hex 32
ANONYMOUS_SESSION_SECRET=remplace_par_un_secret_aleatoire_long

# Stockage serveur des quotas (Postgres Render en production)
DATABASE_URL=remplace_par_url_postgres_render

# RevenueCat serveur — clé REST secrète V1, JAMAIS dans le mobile/GitHub
REVENUECAT_SERVER_API_KEY=remplace_par_cle_revenuecat_serveur
REVENUECAT_ENTITLEMENT_ID=premium

# Nevi Pulse — stockage interne dans le Postgres Render ci-dessus.
# Génère-la avec : openssl rand -hex 32. Ne l'ajoute jamais à l'app mobile.
ANALYTICS_DASHBOARD_TOKEN=remplace_par_un_second_secret_aleatoire_long
# Configure cette même valeur comme Authorization dans le webhook RevenueCat.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer remplace_par_un_secret_webhook_long

# Nevi Pulse — rentabilité (USD)
# Prix payé pour acquérir une installation, à adapter par campagne/canal.
UNIT_ECONOMICS_CAC_USD=1.50
# Part nette estimée après commission App Store : 0.70 standard, 0.85 si
# le compte est éligible au Small Business Program Apple.
UNIT_ECONOMICS_STORE_NET_REVENUE_SHARE=0.70
# Tarifs actifs par défaut OpenAI (à vérifier lors de tout changement de modèle).
UNIT_ECONOMICS_OPENAI_WHISPER_PER_MINUTE_USD=0.006
UNIT_ECONOMICS_OPENAI_LLM_INPUT_PER_MILLION_TOKENS_USD=0.15
UNIT_ECONOMICS_OPENAI_LLM_OUTPUT_PER_MILLION_TOKENS_USD=0.60
UNIT_ECONOMICS_OPENAI_TTS_PER_MILLION_CHARACTERS_USD=15
# Renseigne ces valeurs seulement si ces fournisseurs sont activés.
UNIT_ECONOMICS_GROQ_STT_PER_MINUTE_USD=0
UNIT_ECONOMICS_GROQ_LLM_INPUT_PER_MILLION_TOKENS_USD=0
UNIT_ECONOMICS_GROQ_LLM_OUTPUT_PER_MILLION_TOKENS_USD=0
UNIT_ECONOMICS_ELEVENLABS_TTS_PER_MILLION_CHARACTERS_USD=0

# Fournisseurs actifs par défaut
AI_PROVIDER=openai
TTS_PROVIDER=openai

# OpenAI (requis si AI_PROVIDER=openai ou TTS_PROVIDER=openai)
OPENAI_API_KEY=remplace_par_ta_cle_openai
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_VOICE=nova

# Alternatives optionnelles
GEMINI_API_KEY=remplace_par_ta_cle_gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore

GROQ_API_KEY=gsk_remplace_par_ta_cle_groq
ELEVENLABS_API_KEY=remplace_par_ta_cle_elevenlabs
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

PORT=3000
