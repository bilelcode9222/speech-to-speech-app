# Sécurité backend — obligatoire en local et sur Render.
# Génère une longue valeur aléatoire, par exemple avec : openssl rand -hex 32
ANONYMOUS_SESSION_SECRET=remplace_par_un_secret_aleatoire_long

# Stockage serveur des quotas (Postgres Render en production)
DATABASE_URL=remplace_par_url_postgres_render

# RevenueCat serveur — clé REST secrète V1, JAMAIS dans le mobile/GitHub
REVENUECAT_SERVER_API_KEY=remplace_par_cle_revenuecat_serveur
REVENUECAT_ENTITLEMENT_ID=premium

# Nevi Pulse — lecture PostHog, uniquement côté serveur
# Crée une clé API personnelle PostHog avec accès en lecture au projet.
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=remplace_par_id_du_projet_posthog
POSTHOG_PERSONAL_API_KEY=phx_remplace_par_cle_personnelle_posthog
# Même valeur que EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN, utilisée seulement pour
# ingérer les événements RevenueCat dans PostHog.
POSTHOG_PROJECT_TOKEN=phc_remplace_par_token_public_posthog
# Génère-la avec : openssl rand -hex 32
ANALYTICS_DASHBOARD_TOKEN=remplace_par_un_second_secret_aleatoire_long
# Configure cette même valeur comme Authorization dans le webhook RevenueCat.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer remplace_par_un_secret_webhook_long

# Fournisseurs actifs par défaut
AI_PROVIDER=openai
TTS_PROVIDER=openai

# OpenAI (requis si AI_PROVIDER=openai ou TTS_PROVIDER=openai)
OPENAI_API_KEY=remplace_par_ta_cle_openai
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_VOICE=nova

# Alternatives optionnelles
GEMINI_API_KEY=remplace_par_ta_cle_gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore

GROQ_API_KEY=gsk_remplace_par_ta_cle_groq
ELEVENLABS_API_KEY=remplace_par_ta_cle_elevenlabs
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

PORT=3000
